# ===== 恒易搭部署模式（🔒 一期契约）=====
# saas | private —— 业务代码零部署分支，差异仅由此开关 + 下列环境变量注入
DEPLOY_MODE=private

# ===== 服务端 =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# ⚠️ 生产必须设置为 ≥32 字符强随机值（生产环境若用弱值将拒绝启动）
# 一键生成：pnpm run bootstrap（推荐）或 pnpm run secrets:rotate
# 手动生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_32chars_min
JWT_EXPIRES_IN=8h

# 默认管理员种子密码（仅首次植入时生效；生产务必改密）
# 不设置则使用内置默认值 admin123（生产会打印警告）
ADMIN_BOOTSTRAP_PASSWORD=

# ===== 数据库（🔒 一期锁定 MySQL 8.0）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hengyida
# 占位值；必须与 deployments/private/.env 的 MYSQL_PASSWORD 一致，由 pnpm run bootstrap 自动填充
DB_PASSWORD=your_strong_password_here
DB_NAME=hengyida
# 元数据表前缀（Schema 与 RuntimeRecord 分离）
DB_META_PREFIX=meta_
# 动态业务表前缀，表名 t_form_<formId>
DB_DATA_PREFIX=t_form_

# ===== 前端（Vite 变量须以 VITE_ 开头）=====
VITE_API_BASE_URL=http://localhost:3000/api

# ===== 容器化 MySQL（deployments/private/docker-compose.yml 从同目录 .env 插值）=====
# 占位值；由 pnpm run bootstrap（或 secrets:rotate）自动生成强随机值，只写本地 .env，禁止提交真实值
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=hengyida
MYSQL_USER=hengyida
MYSQL_PASSWORD=your_strong_password_here
# 宿主端口冲突时改 3307，并同步上方 DB_PORT
MYSQL_HOST_PORT=3306
SERVER_HOST_PORT=3000

# ===== 备份（mysql-backup sidecar）=====
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# 同步提示：DB_PASSWORD 必须与 MYSQL_PASSWORD 相同；JWT_SECRET 两文件必须相同。
# 首次使用：pnpm run bootstrap（复制两份 example → 本地 .env → 自动生成强随机凭据）
# 后续轮换：pnpm run secrets:rotate（会同步根 .env 与 deployments/private/.env）

# ===== 可观测 =====
LOG_LEVEL=info
