# 私有化部署环境变量样例（仅占位示例，禁止填入真实凭据）
# 使用前复制为同目录 .env（已被 .gitignore 忽略），再填写本地值。

# ===== MySQL 容器（docker-compose.yml 从此文件插值）=====
# 以下四项必填；真实值只写本地 .env，绝不提交
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=hengyida
MYSQL_USER=hengyida
MYSQL_PASSWORD=your_strong_password_here
# 宿主端口冲突时可改为 3307，并同步仓库根目录 .env 的 DB_PORT
MYSQL_HOST_PORT=3306
SERVER_HOST_PORT=3000

# ===== 容器内 server（DB_HOST=mysql 为 compose 服务名；宿主机调试用 127.0.0.1）=====
DEPLOY_MODE=private
DB_HOST=mysql
DB_PORT=3306
DB_USER=hengyida
DB_PASSWORD=your_strong_password_here
DB_NAME=hengyida
JWT_SECRET=your_strong_jwt_secret_32chars_min
PORT=3000

# ===== 备份 sidecar（每日 mysqldump，保留 7 天）=====
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
