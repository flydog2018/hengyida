# 恒易搭 生产环境（仅占位符，禁止提交真实值）
# 部署前必须用强随机值替换以下三项：MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / JWT_SECRET
MYSQL_ROOT_PASSWORD=__SET_IN_LOCAL_ENV__
MYSQL_DATABASE=hengyida
MYSQL_USER=hengyida
MYSQL_PASSWORD=__SET_IN_LOCAL_ENV__
JWT_SECRET=__SET_IN_LOCAL_ENV__

MYSQL_HOST_PORT=3308
SERVER_HOST_PORT=3002
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=warn
