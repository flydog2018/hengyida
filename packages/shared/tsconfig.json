{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false
  },
  "include": ["index.ts", "types/**/*.ts", "constants/**/*.ts", "utils/**/*.ts"],
  "exclude": ["**/*.test.ts", "dist"]
}
